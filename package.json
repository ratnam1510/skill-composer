{
  "name": "skill-composer",
  "version": "1.0.0",
  "description": "Build-time skill compiler that chains and merges agent skills for zero-overhead composed pipelines across Claude Code, Codex, and Cursor.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "templates",
    "composer.config.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "skill-composer": "bin/skill-composer.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/cli.js",
    "dev": "tsc --watch",
    "compose": "node dist/cli.js compose",
    "scan": "node dist/cli.js scan",
    "graph": "node dist/cli.js graph",
    "stats": "node dist/cli.js stats",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "skills",
    "agent-skills",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "skill-chaining",
    "ai-agents",
    "skill-composer",
    "orchestration",
    "skills.sh"
  ],
  "author": "Ratnam Shah",
  "license": "MIT",
  "homepage": "https://github.com/ratnam1510/skill-composer#readme",
  "bugs": {
    "url": "https://github.com/ratnam1510/skill-composer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratnam1510/skill-composer.git"
  }
}
